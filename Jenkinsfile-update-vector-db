#! groovy
@Library('ai') _
def workerNode = "aibuild-p03"
def slackReceivers = "#ai-jenkins-warnings"

pipeline {
	agent { label workerNode }
	options {
		gitLabConnection('gitlab.dbc.dk')
		disableConcurrentBuilds()
	}
	environment {
		PACKAGE="mitcfu-rag"
		ARTIFACTORY_LOGIN = credentials("artifactory_login")
		DOCKER_TAG = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
		GITLAB_PRIVATE_TOKEN = credentials("ai-gitlab-api-token")
		KAFKA_TOPIC = "cisterne-work-jed-1-3"
	}
	triggers {
		cron("H 3 * * *")
	}
	parameters {
		booleanParam(name: 'BUILD_FROM_SCRATCH', defaultValue: false, description: 'Build index from scratch or update current index.')
	}
	stages {
		stage("Update vector db") {
			when {
				branch "main"
			}
			steps {
				sh """#!/usr/bin/env bash
				set -xe
				rm -rf miniconda.sh miniconda/ embeddings labels.npy mitcfu_faiss_index mitcfu_faiss_index.tgz mitcfu_faiss_index_file.json
				curl -k ${MINICONDA_DOWNLOAD_URL} -o miniconda.sh
				bash miniconda.sh -b -p miniconda
				source miniconda/bin/activate
				python3 -m venv env
				source env/bin/activate
				conda install -y -c conda-forge faiss
				pip install --upgrade pip
				pip install .
				if ${params.BUILD_FROM_SCRATCH} ; then
					echo "Creating index from scratch"
					create-faiss-index --index-output-path mitcfu_faiss_index_file.json --kafka-topic ${KAFKA_TOPIC} --kafka-group-id ai-mitcfu-rag-prod-${DOCKER_TAG} --batch-size 100
				else
					curl -f -L $ARTIFACTORY_LOGIN ${ARTIFACTORY_URL}/${AI_DOCKER_LAYERS}/mitcfu-rag/mitcfu_faiss_index.tgz -o mitcfu_faiss_index.tgz
					curl -u $ARTIFACTORY_LOGIN ${ARTIFACTORY_URL}/${AI_DOCKER_LAYERS}/mitcfu-rag/mitcfu_faiss_index_old.tgz -T mitcfu_faiss_index.tgz
					tar -xzvf mitcfu_faiss_index.tgz
					curl -f -L $ARTIFACTORY_LOGIN ${ARTIFACTORY_URL}/${AI_DOCKER_LAYERS}/mitcfu-rag/mitcfu_faiss_index_file.json -o  mitcfu_faiss_index_file.json
					curl -u $ARTIFACTORY_LOGIN ${ARTIFACTORY_URL}/${AI_DOCKER_LAYERS}/mitcfu-rag/mitcfu_faiss_index_file_old.json -T mitcfu_faiss_index_file.json
					echo "Updating current index"
					create-faiss-index --database-input-path mitcfu_faiss_index --index-input-path mitcfu_faiss_index_file.json --kafka-topic ${KAFKA_TOPIC} --kafka-group-id ai-mitcfu-rag-prod-${DOCKER_TAG} --batch-size 100
				fi
				mv embeddings mitcfu_faiss_index/embeddings
				mv labels.npy mitcfu_faiss_index/labels.npy
				tar -cvzf mitcfu_faiss_index.tgz mitcfu_faiss_index
				curl -u $ARTIFACTORY_LOGIN ${ARTIFACTORY_URL}/${AI_DOCKER_LAYERS}/mitcfu-rag/mitcfu_faiss_index.tgz -T mitcfu_faiss_index.tgz
				curl -u $ARTIFACTORY_LOGIN ${ARTIFACTORY_URL}/${AI_DOCKER_LAYERS}/mitcfu-rag/mitcfu_faiss_index_file.json -T mitcfu_faiss_index_file.json
				"""
			}
		}
		stage("Trigger deployment") {
			agent {
				docker {
					label workerNode
					image "docker-dbc.artifacts.dbccloud.dk/build-env"
					alwaysPull true
				}
			}
			when {
				branch 'main'
			}
			steps {
				build job: "ai/mitcfu-rag/mitfu-rag-service/main", wait: false, propagate: false
			}
		}
	}
	//post {
	//	unstable { slackSend message: "build became unstable for ${env.JOB_NAME}: ${env.BUILD_URL}", channel: slackReceivers }
	//	failure { slackSend message: "build failed for ${env.JOB_NAME}: ${env.BUILD_URL}", channel: slackReceivers }
	//}
}
